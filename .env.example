# Secrets for israel-tv. Copy to .env (next to israel-tv.config.json) and fill in only what you use.
# The config file names these variables; the values never go in the config file or in git.

# Geo proxy with an Israeli exit (only outside Israel; see "geo" in docs/configuration.md)
GEO_PROXY_USERNAME=
GEO_PROXY_PASSWORD=

# Cloudflare publisher (only with "publisher": { "type": "cloudflare" })
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# TMDB matching (only with "tmdb": {}); a free v3 API key from themoviedb.org
TMDB_API_KEY=

# Admin page and usage dashboard (local network only). Any long random value; without it one is generated and
# `pnpm israel-tv admin-url` prints the link.
# ISRAEL_TV_ADMIN_TOKEN=

# Mako away from home (resolver.remote): the secret path token for the tunnel, 32+ random characters
# (openssl rand -hex 32; letters and digits only: it is part of a URL). Changing it revokes every install.
# ISRAEL_TV_REMOTE_TOKEN=
