# Role "host": reads the sites, publishes the catalog to Cloudflare, runs the resolver.

# Cloudflare publisher: an API token from the "Edit Cloudflare Workers" template, and your account id.
# Optional for the public usage counts: the token also needs Account → Account Analytics → Read.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Only if you add a "geo" block to the config (outside Israel; see docs/setup/local-only.md, "Abroad"): the variable names
# its usernameEnv/passwordEnv give.
# GEO_PROXY_USERNAME=
# GEO_PROXY_PASSWORD=

# Only if you add "tmdb": { "apiKeyEnv": "TMDB_API_KEY" } to the config (shows opened from other catalogs).
# TMDB_API_KEY=

# Optional: your own admin token (otherwise generated; `pnpm israel-tv admin-url` prints the link).
# ISRAEL_TV_ADMIN_TOKEN=

# Only with resolver.remote (the helper through your tunnel): openssl rand -hex 32
# ISRAEL_TV_REMOTE_TOKEN=
