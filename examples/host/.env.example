# Role "host": reads the sites, publishes the catalog, runs the resolver. Fill in what your config uses.

# Geo proxy (only outside Israel, or for Kan): the variable names your config's geo.usernameEnv/passwordEnv name.
GEO_PROXY_USERNAME=
GEO_PROXY_PASSWORD=

# Cloudflare publisher: an API token from the "Edit Cloudflare Workers" template, and your account id.
# Optional for the public usage counts: the token also needs Account → Account Analytics → Read.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional: TMDB matching (shows opened from other catalogs).
TMDB_API_KEY=

# Admin page and usage dashboard (otherwise generated; `pnpm israel-tv admin-url` prints the link).
ISRAEL_TV_ADMIN_TOKEN=

# Optional: Mako away from home through your tunnel (resolver.remote). openssl rand -hex 32
ISRAEL_TV_REMOTE_TOKEN=
