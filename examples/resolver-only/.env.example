# Role "resolver-only": you use someone's public Israel TV catalog and run only the home resolver (Mako playback,
# and geo-blocked Reshet/Kan through a proxy when refused where you are). Nothing is required inside Israel.

# Optional: a geo proxy (outside Israel), named by your config's geo.usernameEnv/passwordEnv.
GEO_PROXY_USERNAME=
GEO_PROXY_PASSWORD=

# Optional: Mako away from home through your tunnel (resolver.remote). openssl rand -hex 32
ISRAEL_TV_REMOTE_TOKEN=
