// The private API Worker (rows, search, streams, /status). Deployed by `israel-tv deploy-api` from a code release,
// never by a catalog publish. No public URL: reachable only through the data Worker's service binding.
{
  "name": "israel-tv-api",
  "main": "src/api.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
