{
  "name": "israel-tv",
  "version": "0.13.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "typecheck": "pnpm -r --no-bail typecheck",
    "lint": "biome ci --error-on-warnings .",
    "format": "biome check --write .",
    "test": "pnpm -r --no-bail test",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm boundaries && pnpm hygiene && pnpm check:addresses && pnpm test",
    "start": "node apps/ingest/src/cli.ts start",
    "israel-tv": "node apps/ingest/src/cli.ts",
    "logs": "node apps/ingest/src/cli.ts events",
    "usage": "node apps/ingest/src/cli.ts usage",
    "resolver": "node apps/resolver/src/cli.ts",
    "boundaries": "depcruise --config .dependency-cruiser.cjs apps packages",
    "hygiene": "knip && pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" exec publint --strict",
    "test:strict": "node tools/test-strict.mjs",
    "smoke": "node tools/smoke.mjs",
    "check:addresses": "node tools/check-addresses.mjs",
    "e2e:dashboard": "node tools/dashboard-e2e.mjs",
    "budget:workers": "node tools/worker-budget.mjs",
    "shots:dashboard": "node tools/dashboard-shots.mjs",
    "audit:images": "node tools/image-audit.mjs",
    "shots:site": "node tools/site-shots.mjs",
    "images:site": "node tools/site-images.mjs",
    "build": "pnpm --filter @israel-tv/dashboard build",
    "preview:site": "node tools/site-preview.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@swc/core": "1.16.22",
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.7.2",
    "knip": "6.44.1",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "playwright-core": "catalog:",
    "lefthook": "2.2.2"
  },
  "license": "AGPL-3.0-only"
}
