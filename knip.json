{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tools/*.mjs"],
      "project": ["tools/*.mjs"]
    },
    "apps/catalog": {
      "entry": ["src/api.ts"]
    },
    "spikes": {
      "ignore": ["**"]
    },
    "apps/dashboard": {
      "entry": ["test/*.ts"],
      "project": ["src/**/*.{ts,tsx,css}", "server/*.ts", "test/*.ts"]
    },
    "packages/render": {
      "ignore": ["src/client/**"]
    }
  },
  "ignoreDependencies": ["wrangler", "pino-roll", "@swc/core"],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["vm_stat"]
}
