{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tools/*.mjs"],
      "project": ["tools/*.mjs"]
    },
    "apps/catalog": {
      "entry": ["src/api.ts"]
    },
    "spikes": {
      "ignore": ["**"]
    },
    "apps/dashboard": {
      "entry": ["web/main.ts"]
    }
  },
  "ignoreDependencies": ["wrangler", "pino-roll", "@swc/core"],
  "ignoreExportsUsedInFile": true
}
